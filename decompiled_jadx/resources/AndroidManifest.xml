<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system"
    android:versionCode="19"
    android:versionName="4.4.4-27"
    package="com.sprd.simple.launcher">
    <uses-sdk
        android:minSdkVersion="19"
        android:targetSdkVersion="19"/>
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <application
        android:label="@string/app_name1"
        android:name="com.sprd.classichome.HomeApplication"
        android:supportsRtl="true">
        <activity
            android:theme="@style/BaseHomeTheme"
            android:name="com.sprd.classichome.Home"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="mnc|mcc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.MONKEY"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/BaseHomeTheme"
            android:label="@string/idle_main_menu"
            android:name="com.sprd.classichome.mainmenu.MainMenuActivity"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="mnc|mcc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/BaseTheme"
            android:label="@string/qtn_idle_extra"
            android:icon="@mipmap/duoqin_launcher_extras"
            android:name="com.sprd.classichome.ExtrasActivity"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/BaseTheme"
            android:label="@string/qtn_idle_games"
            android:icon="@mipmap/duoqin_launcher_games"
            android:name="com.sprd.classichome.GamesActivity"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/BaseTheme"
            android:label="@string/wallpapers"
            android:name="com.sprd.wallpaperpicker.SetWallpaperActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/BaseNoActionBarTheme"
            android:label="@string/background"
            android:name="com.sprd.wallpaperpicker.PreviewWallpaperActivity"
            android:screenOrientation="portrait"/>
    </application>
</manifest>
