<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.sprd.simple.launcher.mod">
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.BIND_APPWIDGET"/>
    <application android:label="@string/app_name1" android:name="com.sprd.classichome.HomeApplication" android:supportsRtl="true">
        <activity android:configChanges="mcc|mnc" android:icon="@drawable/ic_launcher_settings" android:label="מסך הבית המשודרג" android:launchMode="singleTask" android:name="com.sprd.classichome.Home" android:screenOrientation="portrait" android:theme="@style/BaseHomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.MONKEY"/>
            </intent-filter>
        </activity>
        <activity android:configChanges="mcc|mnc" android:label="@string/idle_main_menu" android:launchMode="singleTask" android:name="com.sprd.classichome.mainmenu.MainMenuActivity" android:screenOrientation="portrait" android:theme="@style/BaseHomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:icon="@mipmap/duoqin_launcher_extras" android:label="@string/qtn_idle_extra" android:launchMode="singleTask" android:name="com.sprd.classichome.ExtrasActivity" android:theme="@style/BaseTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:icon="@mipmap/duoqin_launcher_games" android:label="@string/qtn_idle_games" android:launchMode="singleTask" android:name="com.sprd.classichome.GamesActivity" android:theme="@style/BaseTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:label="@string/wallpapers" android:name="com.sprd.wallpaperpicker.SetWallpaperActivity" android:screenOrientation="portrait" android:theme="@style/BaseTheme">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:label="@string/background" android:name="com.sprd.wallpaperpicker.PreviewWallpaperActivity" android:screenOrientation="portrait" android:theme="@style/BaseNoActionBarTheme"/>
        <activity android:icon="@drawable/ic_launcher_settings" android:label="@string/launcher_settings_title" android:launchMode="singleTask" android:name="com.sprd.classichome.settings.LauncherSettingsActivity" android:screenOrientation="portrait" android:theme="@style/BaseTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
