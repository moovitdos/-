<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/duoqin_color_text_disable" />
    <item android:state_window_focused="false" android:color="@color/duoqin_color_text_primary" />
    <item android:state_focused="true" android:color="@color/duoqin_color_text_primary" />
    <item android:state_pressed="true" android:color="@color/duoqin_color_text_primary" />
    <item android:state_selected="true" android:color="@color/duoqin_color_text_primary" />
    <item android:color="@color/duoqin_color_text_primary" android:state_activated="true" />
    <item android:state_enabled="false" android:state_selected="true" android:color="@color/duoqin_color_text_disable" />
    <item android:state_enabled="false" android:state_pressed="true" android:color="@color/duoqin_color_text_disable" />
    <item android:color="@color/duoqin_color_text_primary" />
</selector>
